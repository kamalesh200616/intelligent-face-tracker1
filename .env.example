# Environment Variables Template
# Copy to .env and configure for live RTSP streaming or private camera credentials

# Video Source Settings
# Set to 'file', 'rtsp', or 'webcam'
VIDEO_SOURCE_TYPE=file
VIDEO_SOURCE_PATH=data/sample_video.mp4

# RTSP Stream Configuration (Never commit private RTSP credentials!)
RTSP_STREAM_URL=rtsp://username:password@192.168.1.100:554/stream1

# Recognition & Detection Tuning
SIMILARITY_THRESHOLD=0.60
DETECTION_CONFIDENCE=0.65
FRAME_SKIP_INTERVAL=2
TRACK_LOST_TIMEOUT_SECONDS=2.0

# Database & Logging
DATABASE_PATH=data/visitor_tracker.db
LOG_LEVEL=INFO
